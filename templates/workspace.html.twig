{% extends 'base.html.twig' %}
{% block body %}
<div class="app-shell">
    <aside class="app-sidebar">
        <a href="{{ path('app_dashboard') }}" class="brand"><img src="/favicon.svg" alt="" width="40" height="40"><span>Basket<span class="brand-light">Metrics</span><small>LE JEU. LES CHIFFRES.</small></span></a>
        <div class="sidebar-section-label">ESPACE COACH</div>
        <nav aria-label="Navigation principale" class="sidebar-nav">
            <a class="nav-link {{ app.current_route != 'app_team_new' ? 'active' : '' }}" href="{{ path('app_dashboard') }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/></svg>Mes équipes<span class="nav-dot"></span></a>
            <a class="nav-link {{ app.current_route == 'app_team_new' ? 'active' : '' }}" href="{{ path('app_team_new') }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Créer une équipe</a>
        </nav>
        <div class="sidebar-note"><span class="eyebrow">AU BORD DU TERRAIN</span><p>Chaque match compte.<br>Chaque détail aussi.</p><span class="tiny-court" aria-hidden="true"></span></div>
        <div class="sidebar-user"><span class="user-avatar">{{ app.user.username|slice(0, 1)|upper }}</span><div><strong>{{ app.user.username }}</strong><small>Mon espace personnel</small></div></div>
    </aside>
    <div class="app-main">
        <header class="app-topbar"><span class="topbar-location"><span class="status-dot"></span>Votre espace basket</span><form action="{{ path('app_logout') }}" method="post" data-turbo="false"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout-button" type="submit">Se déconnecter <span aria-hidden="true">↗</span></button></form></header>
        <main class="workspace-content" id="main-content">
            {% for message in app.flashes('success') %}<p role="status" class="success-message"><span aria-hidden="true">✓</span> {{ message }}</p>{% endfor %}
            {% for message in app.flashes('error') %}<p role="alert" class="mt-4 rounded-xl border border-red-400/30 bg-red-400/10 p-4 text-red-300">{{ message }}</p>{% endfor %}
            {% block workspace_content %}{% endblock %}
        </main>
        <footer class="app-footer"><span>BasketMetrics</span><span>De la feuille de match au prochain progrès.</span></footer>
    </div>
</div>
{% endblock %}

