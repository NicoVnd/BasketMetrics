{% extends 'security/layout.html.twig' %}
{% block title %}Connexion — BasketMetrics{% endblock %}
{% block auth_content %}
<h1 class="text-3xl font-bold">Connexion</h1>
<p class="mt-3 text-subtle">Retrouvez votre espace basket.</p>
{% for message in app.flashes('success') %}<p role="status" class="mt-4 text-success">{{ message }}</p>{% endfor %}
{% if error %}<p role="alert" class="mt-4 text-danger">Connexion impossible. Vérifiez vos identifiants ou réessayez plus tard.</p>{% endif %}
<form method="post" action="{{ path('app_login') }}" data-turbo="false" class="mt-6 space-y-5">
    <div><label for="username">Identifiant</label><input class="auth-input" id="username" name="_username" value="{{ last_username }}" autocomplete="username" maxlength="32" required autofocus></div>
    <div><label for="password">Mot de passe</label><input class="auth-input" id="password" type="password" name="_password" autocomplete="current-password" required></div>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <button class="auth-button" type="submit">Se connecter</button>
</form>
<p class="mt-6 text-sm text-subtle">Pas encore de compte ? <a class="text-accent underline" href="{{ path('app_register') }}">Créer un compte</a></p>
{% endblock %}
