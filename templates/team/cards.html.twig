<section id="equipes"><div class="section-heading"><div><p class="eyebrow">VOTRE ESPACE COACH</p><h2>Mes équipes <span class="count-badge">{{ teams|length }}</span></h2></div><a class="button-secondary" href="{{ path('app_team_new') }}">＋ Nouvelle équipe</a></div><div class="teams-grid">{% for item in teams %}<a href="{{ path('app_team_show',{id:item.id}) }}" class="team-card" data-reveal><div class="team-card-top"><span class="team-avatar">{{ item.name|slice(0,2)|upper }}</span><span class="team-card-arrow" aria-hidden="true">↗</span></div><p class="team-category">{{ item.category ?: 'Mon équipe' }}</p><h3>{{ item.name }}</h3><div class="team-card-bottom">Effectif, matchs et statistiques <span aria-hidden="true">→</span></div></a>{% else %}<section class="empty-teams">{% include 'components/basketball_visual.html.twig' with {visualClass: 'empty-basketball'} %}<h3>Construisez votre collectif.</h3><p>Créez votre équipe, ajoutez vos joueurs et importez votre première feuille de match.<br>Vos statistiques prendront vie à chaque rencontre.</p><a class="button-primary" href="{{ path('app_team_new') }}">Créer ma première équipe →</a></section>{% endfor %}</div></section>
