{% extends 'workspace.html.twig' %}
{% block title %}Vue d’ensemble — BasketMetrics{% endblock %}
{% block workspace_content %}
<header class="page-heading" data-reveal><div><p class="eyebrow"><span class="heading-symbol" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2 12 6 8l3 2 5-7M9 3h5v5"/></svg></span> LE JEU EN PERSPECTIVE</p><h1>Vue d’ensemble</h1><p class="page-description">{% if team %}{{ team.name }} · Saison {{ season.label }}{% else %}Votre prochain progrès commence ici.{% endif %}</p></div><a class="{{ team ? 'button-primary' : 'button-secondary' }}" href="{{ team ? path('app_import_new',{id:team.id}) : path('app_team_new') }}">{{ team ? '＋ Importer une feuille de match' : '＋ Créer une équipe' }}</a></header>
{% if team %}
<form method="get" class="context-filter season-filter"><label for="team">Équipe</label><select name="team" id="team">{% for item in teams %}<option value="{{ item.id }}" {{ item.id == team.id ? 'selected' : '' }}>{{ item.name }}</option>{% endfor %}</select><label for="season">Saison</label><select name="season" id="season">{% for year,label in season.seasons %}<option value="{{ year }}" {{ year == season.year ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select><button class="button-secondary" type="submit">Afficher</button><a class="button-ghost" href="{{ path('app_team_show',{id:team.id,season:season.year}) }}">Gérer l’équipe ↗</a></form>
{% include 'statistics/kpis.html.twig' %}
<div class="overview-grid">
<section class="panel performance-panel" data-reveal><div class="panel-heading"><div><p class="eyebrow">PERFORMANCE COLLECTIVE</p><h2><span class="panel-index" aria-hidden="true">01</span>Le rythme de la saison</h2></div><span class="count-badge">Points / match</span></div><p class="stats-note">Points marqués et encaissés au fil des rencontres terminées.</p>{% if teamChart %}<div class="stats-chart">{{ render_chart(teamChart, { 'aria-label': 'Évolution des points marqués et encaissés', role: 'img' }) }}</div>{% else %}<div class="chart-empty">{% include 'components/basketball_visual.html.twig' with {visualClass: 'empty-basketball'} %}<h3>La saison reste à écrire</h3><p>Votre premier match terminé fera apparaître les courbes.</p><a class="button-secondary" href="{{ path('app_import_new',{id:team.id}) }}">Importer un match</a></div>{% endif %}</section>
<section class="panel form-panel" data-reveal><div class="panel-heading"><div><p class="eyebrow">DYNAMIQUE RÉCENTE</p><h2><span class="panel-index" aria-hidden="true">02</span>La forme du collectif</h2></div></div><div class="form-badges large-badges">{% for result in summary.form %}<a aria-label="{{ result.result == 'V' ? 'Victoire' : (result.result == 'D' ? 'Défaite' : 'Nul') }} contre {{ result.game.opponent }}" title="{{ result.game.opponent }}" class="result-badge result-{{ result.result }}" href="{{ path('app_match_show',{teamId:team.id,id:result.game.id}) }}">{{ result.result }}</a>{% else %}<p class="stats-note">Aucun résultat connu pour cette saison.</p>{% endfor %}</div><p class="stats-note">Les cinq derniers résultats, du plus ancien au plus récent.</p><dl class="split-list"><div><dt>Domicile</dt><dd>{{ summary.splits.home.wins }} V <span>/ {{ summary.splits.home.losses }} D</span></dd></div><div><dt>Extérieur</dt><dd>{{ summary.splits.away.wins }} V <span>/ {{ summary.splits.away.losses }} D</span></dd></div><div><dt>Écart cumulé</dt><dd>{{ summary.difference.total ?? '—' }} <span>pts</span></dd></div></dl>{% include 'components/court.html.twig' %}</section>
<section class="panel" data-reveal><div class="panel-heading"><h2><span class="panel-index" aria-hidden="true">03</span>Derniers matchs</h2><a class="button-ghost" href="{{ path('app_team_matches',{id:team.id,season:season.year}) }}">Tout voir →</a></div>{% include 'match/list.html.twig' with {matches:summary.games|reverse|slice(0,5)} %}</section>
<section class="panel" data-reveal><div class="panel-heading"><h2><span class="panel-index" aria-hidden="true">04</span>Meilleurs marqueurs</h2><span class="count-badge">Pts / match</span></div><ol class="leader-list">{% for row in season.ranking|slice(0,5) %}<li><span class="rank-number">{{ row.rank ?? '—' }}</span><a href="{{ path('app_player_show',{teamId:team.id,id:row.player.id,season:season.year}) }}">{{ row.player.fullName }}<small>{{ row.metrics.points.count }} matchs renseignés</small></a><strong>{{ row.metrics.points.average is not null ? row.metrics.points.average|number_format(1, ',') : '—' }}</strong></li>{% else %}<li class="stats-note">Ajoutez des joueurs à l’équipe pour suivre leurs performances.</li>{% endfor %}</ol><p class="stats-note">Moyennes sur les valeurs connues uniquement.</p></section>
</div>
{% endif %}
{% include 'team/cards.html.twig' %}
{% endblock %}
