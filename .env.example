# Copier les valeurs nécessaires dans .env.local (jamais versionné).
APP_ENV=dev
APP_SECRET=replace_with_random_secret
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
# SQLite permet de démarrer sans compte externe.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/basket.db"
# Supabase : remplacer avec les paramètres exacts du tableau de bord.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require&charset=utf8"
GEMINI_API_KEY=
GEMINI_MODEL=
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=match-documents
SUPABASE_SERVICE_ROLE_KEY=

PDFTOPPM_BINARY=pdftoppm
NODE_BINARY=node
